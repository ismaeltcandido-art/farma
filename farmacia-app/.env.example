# Copie para .env apenas para uso LOCAL. Na Hostinger, cadastre estas
# variáveis no painel (Web App -> Environment variables). Nunca suba o .env.

# Porta: a Hostinger define a PORT; localmente use 3000
PORT=3000
NODE_ENV=production

# Caminho base do sistema (https://projetoisma.com/farmacia)
BASE_PATH=/farmacia

# MySQL (hPanel -> Bancos de dados MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Segredo para assinar a sessão (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Usuário inicial (criado só se ainda não existir nenhum usuário).
# Depois do primeiro acesso, REMOVA ADMIN_PASSWORD das variáveis.
ADMIN_USER=
ADMIN_PASSWORD=
